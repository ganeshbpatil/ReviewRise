# Database
DATABASE_URL="postgresql://reviewrise:your_password@localhost:5432/reviewrise"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"

# Google OAuth (for login + GBP)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google/callback"

# AI APIs
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Cloudflare R2 Storage
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="reviewrise"
R2_PUBLIC_URL="https://pub-your-r2-public-url.r2.dev"

# Docker Compose
POSTGRES_PASSWORD="strong_postgres_password"
REDIS_PASSWORD="strong_redis_password"
